# Cloudflare Tunnel Connector Token
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Comma-separated list of application names to blacklist from the stream
# (These apps will still play in your headphones, but will NOT be heard on the stream)
AUDIO_BLACKLIST=discord,Discord,vesktop,webcord,slack,zoom,teams

# Include microphone in the stream mix (false: only non-blacklisted desktop audio)
INCLUDE_MIC=false

# Stream Output Dimensions & Framerate
FRAMERATE=60
TARGET_WIDTH=1920
TARGET_HEIGHT=1080
VIDEO_BITRATE=6000k
MAX_BITRATE=8000k
BUFSIZE=12000k

# HLS Segment Duration (seconds)
HLS_TIME=2
HLS_LIST_SIZE=5
