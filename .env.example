# Cloudflare Tunnel Connector Token
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Audio Mode:
# - AUDIO_ROUTING=true (Default) : Voice isolation mode.
#   Filters out apps in AUDIO_BLACKLIST (e.g. Discord, Slack) from the stream.
# - AUDIO_ROUTING=false (or AUDIO_SOURCE=mirror) : Passive mirror mode.
#   Captures raw headphone mix (includes all voice calls/Discord).
AUDIO_ROUTING=true
AUDIO_SOURCE=stream_sink.monitor

# Comma-separated list of application names to blacklist from the stream (when AUDIO_ROUTING=true)
AUDIO_BLACKLIST="discord,Discord,vesktop,webcord,slack,zoom,teams,webrtc,webrtc voiceengine"

# Include microphone in the stream mix (false: only desktop audio)
INCLUDE_MIC=false

# Video Encoder Choice:
# - gpu   : Hardware accelerated encoding (VA-API for AMD/Intel, NVENC for NVIDIA) [Recommended]
# - cpu   : Software encoding via libx264/x264enc (fallback / CPU-only)
ENCODER=gpu

# Number of CPU threads to allocate for software encoding (if ENCODER=cpu)
CPU_THREADS=4

# Stream Output Dimensions & Framerate
FRAMERATE=60
TARGET_WIDTH=1920
TARGET_HEIGHT=1080
VIDEO_BITRATE=6000k
MAX_BITRATE=8000k
BUFSIZE=12000k

# HLS Segment Duration (seconds)
HLS_TIME=2
HLS_LIST_SIZE=5
